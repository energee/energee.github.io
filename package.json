{
  "name": "energee",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run typecheck && bun run --parallel dev:serve dev:types",
    "dev:serve": "bun --port 8000 ./src/index.html",
    "dev:types": "tsc --watch --preserveWatchOutput",
    "build": "bun run typecheck && bun ./build.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.50.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0"
  }
}
